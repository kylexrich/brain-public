{
  "name": "brain",
  "private": true,
  "type": "module",
  "bin": {
    "brain": "./bin/brain"
  },
  "oclif": {
    "bin": "brain",
    "dirname": "brain",
    "topicSeparator": " ",
    "commands": {
      "strategy": "pattern",
      "target": "./commands",
      "globPatterns": [
        "**/*.+(js|cjs|mjs|ts|mts|cts)",
        "!**/*.+(d.*|test.*|spec.*|helpers.*)?(x)"
      ]
    }
  },
  "scripts": {
    "brain": "tsx bin/run.ts",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "script:agents:sync": "tsx bin/run.ts repo agents-header",
    "script:skills:sync": "tsx bin/run.ts repo sync-skills",
    "script:instructions:sync": "tsx bin/run.ts repo sync-instructions",
    "script:sync:all": "tsx bin/run.ts repo sync-ai && tsx bin/run.ts repo sync-skills && tsx bin/run.ts repo sync-instructions",
    "script:public:export": "tsx bin/run.ts repo export-public"
  },
  "dependencies": {
    "@oclif/core": "^4.10.2",
    "better-sqlite3": "^11.10.0",
    "googleapis": "^154.1.0",
    "node-edge-tts": "^1.2.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.5.2",
    "eslint": "^9.24.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.0"
  }
}
