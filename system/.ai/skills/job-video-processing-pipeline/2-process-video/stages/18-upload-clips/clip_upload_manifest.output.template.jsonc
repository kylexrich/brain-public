// clip_upload_manifest.json — output artifact written by stage 18-upload-clips
// Written to: <stream_dir>/meta/outputs/clip_upload_manifest.json
//
// Includes ALL clips considered (production-success ∪ rated). Uploaded clips have status=success.
// Clips that failed production or rated hold/reject are recorded with status=skipped + skip_reason.
{
  "generated_at": "ISO8601",
  "source_clip_manifest": "/absolute/path/to/clip_production_manifest.json",
  "source_rating_manifest": "/absolute/path/to/clip_rating_manifest.json",
  "source_stream_url": "https://youtube.com/watch?v=...",
  "default_privacy_status": "private | unlisted | public",
  "clip_count": 6,
  "clips": [
    {
      "filename": "01-clip-title.mp4",
      "title": "Clip Title",
      "vibe_tier": "FAILURE_AND_RECOVERY | CHESS_CODE_FUSION | ENGINEERING_OPINION | AI_ORCHESTRATION_MOMENT | LIVE_INCIDENT | CHESS_INSIGHT | FOUNDER_LIFE",
      "format": "HIGHLIGHT | TUTORIAL | STORY",
      "aggregate_verdict": "publish | hold | reject",
      "status": "success | error | skipped",
      "skip_reason": "production_failed | rating_hold | rating_reject | null",
      "privacy_status": "private | unlisted | public | null",
      "video_id": "11-char-youtube-id | null",
      "url": "https://youtube.com/watch?v=<video_id> | null",
      "uploaded_at": "ISO8601 | null",
      "category_id": "28 | null",
      "contains_synthetic_media": false,
      "error": "string | null"
    }
  ]
}
