# Copy this public-safe template to the sibling `.env` runtime file and fill in
# values. Private-only variable names are intentionally omitted; `.env` is
# ignored by git.
#
# Quoting convention: single quotes for literal values — prevents the shell from
# expanding special characters (!, $, backticks) when sourced. Use double quotes
# only when a value intentionally references another variable.

# --- Brain core ---------------------------------------------------------------
export BRAIN_ROOT="$HOME/Developer/brain"
export BRAIN_DEFAULT_TIMEZONE='America/Vancouver'
export BRAIN_WHISPER_MODEL_PATH='/opt/homebrew/share/whisper-cpp/ggml-large-v3-turbo.bin'

# --- Google accounts ----------------------------------------------------------
export PERSONAL_GOOGLE_ACCOUNT_EMAIL_ADDRESS=''

# --- AI / general API keys ----------------------------------------------------
export OPENAI_API_KEY=''
export GEMINI_API_KEY=''
export CONTEXT7_API_KEY=''
export FIRECRAWL_API_KEY=''

# --- Apple Music --------------------------------------------------------------
export APPLE_MUSIC_DEVELOPER_TOKEN=''
export APPLE_MUSIC_USER_TOKEN=''
export APPLE_MUSIC_STOREFRONT='us'

# --- 1Password ----------------------------------------------------------------
export ONE_PASSWORD_PASSWORD=''
export ONE_PASSWORD_KEY=''

# --- BlueBubbles --------------------------------------------------------------
export BB_PASSWORD=''

# --- OpenClaw (legacy runtime archive) ----------------------------------------
export OPENCLAW_CONFIG_PATH="$BRAIN_ROOT/deprecated/openclaw/mbp-m4max-16/openclaw.json"
export OPENCLAW_BLUEBUBBLES_PASSWORD="$BB_PASSWORD"
export OPENCLAW_BRAVE_API_KEY=''
export OPENCLAW_GATEWAY_TOKEN=''
export OPENCLAW_SLACK_APP_TOKEN=''
export OPENCLAW_SLACK_BOT_TOKEN=''
export OPENCLAW_TELEGRAM_BOT_TOKEN=''
