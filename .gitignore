.DS_Store
.idea/
node_modules/
dist/
*.tsbuildinfo
*.bak
*.bak*
**/.openclaw
**/.env
deprecated/openclaw/**/config/
system/credentials/**

# Temp Files
*.tmp
*.tmp.*
.tmp*
tmp/
temp/
*.temp
*.temp.*
.temp*

# OpenClaw temporary files (any depth)
deprecated/openclaw/**/*.swp
deprecated/openclaw/**/*.swo
deprecated/openclaw/**/*~
deprecated/openclaw/**/*.orig
deprecated/openclaw/**/*.pyc
deprecated/openclaw/**/__pycache__/
deprecated/openclaw/**/*.log

# Live OpenClaw runtime workspaces (tracked snapshots live in deprecated/openclaw/mbp-m4max-16/)
deprecated/openclaw/main/
deprecated/openclaw/team/
deprecated/openclaw/cron/

# Stream pipeline media artifacts
vault/stream-videos/**/*.mov
vault/stream-videos/**/*.mp4
vault/stream-videos/**/*.wav
vault/stream-videos/**/*.m4a

# BlueBubbles channel downloaded attachments
system/.dot-claude/channels/bluebubbles/attachments/

# AI config (symlinked from ~/.claude, ~/.codex — only curated files live here)
system/.dot-*/**/.DS_Store
system/.dot-claude/backups/
system/.dot-*/**/*.backup.*
system/.dot-*/**/*.bak
system/.dot-*/**/sessions/

# Claude Code projects — ignore conversation data, keep memory/ subdirs
system/.dot-claude/projects/**
!system/.dot-claude/projects/*/
!system/.dot-claude/projects/*/memory/
!system/.dot-claude/projects/*/memory/**
oclif.manifest.json

deprecated/openclaw/**/cron/runs/

.claude/worktrees/

system/.dot-claude/plugins/known_marketplaces.json
system/.dot-claude/claude.json
system/.dot-claude/claude-desktop-config.json
system/.dot-claude/plans/

system/.dot-claude/plugins/cache/claude-plugins-official/superpowers/5.0.7
**/temp_git_*/

.memsearch/.index.pid


*.log

.claude/scheduled_tasks.lock
